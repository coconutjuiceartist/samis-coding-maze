# Copy to .streamlit/secrets.toml and fill in to use a paid provider.
# Never commit the real secrets.toml (it is gitignored).
#
# Select the provider via the OPPORTUNITY_PROVIDER env var or here:
# provider = "tradier"
#
# [tradier]
# token = "YOUR_TRADIER_TOKEN"
#
# [eodhd]
# api_key = "YOUR_EODHD_KEY"
#
# [polygon]
# api_key = "YOUR_POLYGON_KEY"
